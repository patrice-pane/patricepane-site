# Security headers, applied by Cloudflare Pages at serve time.

# Uploaded media: an SVG/HTML file opened directly would otherwise execute
# scripts on this origin (where the CMS token lives). This CSP blocks that;
# images still display normally via <img> tags.
/uploads/*
  Content-Security-Policy: default-src 'none'
  X-Content-Type-Options: nosniff

# Site-wide hardening. Deliberately minimal: a strict CSP would be a
# maintenance burden (breaks on the next feature); sanitization at build
# time does the heavy anti-XSS lifting instead.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The admin must never be embeddable (clickjacking on the CMS session).
/admin/*
  X-Frame-Options: DENY
